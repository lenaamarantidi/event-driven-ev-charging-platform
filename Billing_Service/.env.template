# =====================================================
# BILLING_SERVICE Environment Variables
# =====================================================
# Copy this to .env file in Billing_Service/

# Server Port
PORT=3103

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=billing_user
DB_PASSWORD=billing_pass
DB_NAME=billing_db

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Billing Configuration
DEFAULT_COST_PER_RESERVATION=0.50
DEFAULT_COST_PER_CHARGING_HOUR=1.00
DEFAULT_SETUP_FEE=0.00
TAX_RATE=0.21
PAYMENT_TERMS_DAYS=30
