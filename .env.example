# Environment Variables - Production Configuration

# Node Environment
NODE_ENV=production

# Ports
PORT=3000
POINTS_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3100
PROVIDER_MGMT_SERVICE_PORT=3101
PROVIDER_API_SERVICE_PORT=3200
STATUS_SERVICE_PORT=3102
COLLECTOR_SERVICE_PORT=3104
MAP_SERVICE_PORT=3105
ANALYTICS_SERVICE_PORT=3106
PAYMENT_SERVICE_PORT=3107
BILLING_SERVICE_PORT=3108
MESSAGE_BROKER_PORT=3003
RESERVATION_SERVICE_PORT=3009

# Database Configuration
DB_HOST=mysql.production.local
DB_PORT=3306
DB_USER=saasplug_user
DB_PASSWORD=secure_password_here
DB_POOL_LIMIT=10

# PostgreSQL Configurations
POINTS_DB_URL=postgresql://postgres:password@localhost:5432/points_service
RESERVATIONS_DB_URL=postgresql://postgres:password@localhost:5432/reservations_service
STATUS_DB_URL=postgresql://postgres:password@localhost:5432/status_service
ANALYTICS_DB_URL=postgresql://postgres:password@localhost:5432/analytics_service
BILLING_DB_URL=postgresql://postgres:password@localhost:5432/billing_service
PROVIDER_DB_URL=postgresql://postgres:password@localhost:5432/provider_service

# RabbitMQ Configuration
RABBITMQ_URL=amqp://rabbitmq_user:rabbitmq_pass@rabbitmq.production.local:5672
RABBITMQ_VHOST=/saasplug

# Provider APIs
REDPLUG_BASE_URL=https://davinci.softlab.ntua.gr/saas26/redPlug/api
GREENPLUG_BASE_URL=https://davinci.softlab.ntua.gr/saas26/greenPlug/api
BLUEPLUG_BASE_URL=https://davinci.softlab.ntua.gr/saas26/bluePlug/api

# Service URLs (for inter-service communication)
POINTS_SERVICE_URL=http://points-service.local:3001
AUTH_SERVICE_URL=http://auth-service.local:3100
PROVIDER_MGMT_SERVICE_URL=http://provider-mgmt-service.local:3101
PROVIDER_API_SERVICE_URL=http://provider-api-service.local:3200
STATUS_SERVICE_URL=http://status-service.local:3102
COLLECTOR_SERVICE_URL=http://collector-service.local:3104
MAP_SERVICE_URL=http://map-service.local:3105
ANALYTICS_SERVICE_URL=http://analytics-service.local:3106
PAYMENT_SERVICE_URL=http://payment-service.local:3107
BILLING_SERVICE_URL=http://billing-service.local:3108
MESSAGE_BROKER_URL=http://message-broker.local:3003
RESERVATION_SERVICE_URL=http://reservation-service.local:3009

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key

# Billing Configuration
RESERVATION_CHARGE_RED_CENTS=100
RESERVATION_CHARGE_GREEN_CENTS=50
RESERVATION_CHARGE_BLUE_CENTS=75
API_CALL_CHARGE_CENTS=50

# Sync Schedule (24-hour format, comma-separated)
SYNC_TIMES=02:00,10:00,18:00

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/saasplug/service.log

# Features
ENABLE_ANALYTICS=true
ENABLE_BILLING=true
ENABLE_AUTO_INVOICING=true
INVOICE_GENERATION_HOUR=23

# Timeouts (milliseconds)
API_TIMEOUT=15000
DB_TIMEOUT=30000

# Features Flags
FEATURE_GEO_CLUSTERING=true
FEATURE_HEATMAP=true
FEATURE_NEARBY_SEARCH=true
