# Environment Variables - Production Configuration

# Node Environment
NODE_ENV=production

# Ports
PORT=3000

# Database Configuration
DB_HOST=mysql.production.local
DB_PORT=3306
DB_USER=saasplug_user
DB_PASSWORD=secure_password_here
DB_POOL_LIMIT=10

# RabbitMQ Configuration
RABBITMQ_URL=amqp://rabbitmq_user:rabbitmq_pass@rabbitmq.production.local:5672
RABBITMQ_VHOST=/saasplug

# Provider APIs
REDPLUG_API_URL=https://davinci.softlab.ntua.gr/saas26/redPlug/api
GREENPLUG_API_URL=https://davinci.softlab.ntua.gr/saas26/greenPlug/api
BLUEPLUG_API_URL=https://davinci.softlab.ntua.gr/saas26/bluePlug/api

# Service URLs (for inter-service communication)
CENTRAL_SERVICE_URL=http://central-service.local:3001
STATUS_SERVICE_URL=http://status-service.local:3002

# Billing Configuration
RESERVATION_CHARGE_RED_CENTS=100
RESERVATION_CHARGE_GREEN_CENTS=50
RESERVATION_CHARGE_BLUE_CENTS=75
API_CALL_CHARGE_CENTS=50

# Sync Schedule (24-hour format, comma-separated)
SYNC_TIMES=02:00,10:00,18:00

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/saasplug/service.log

# Features
ENABLE_ANALYTICS=true
ENABLE_BILLING=true
ENABLE_AUTO_INVOICING=true
INVOICE_GENERATION_HOUR=23

# Timeouts (milliseconds)
API_TIMEOUT=15000
DB_TIMEOUT=30000

# Features Flags
FEATURE_GEO_CLUSTERING=true
FEATURE_HEATMAP=true
FEATURE_NEARBY_SEARCH=true
