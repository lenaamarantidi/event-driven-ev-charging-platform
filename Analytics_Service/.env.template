# =====================================================
# ANALYTICS_SERVICE Environment Variables
# =====================================================
# Copy this to .env file in Analytics_Service/

# Server Port
PORT=3102

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=analytics_user
DB_PASSWORD=analytics_pass
DB_NAME=analytics_db

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Analytics Configuration
# Period defaults if not specified in queries
DEFAULT_ANALYTICS_PERIOD=monthly
MAX_DAILY_RECORDS_RETURNED=365
