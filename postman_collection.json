{
  "info": {
    "name": "SaaS Plug - Multi-Provider API",
    "description": "Postman collection for testing the unified API with provider adapters",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Gateway",
      "item": [
        {
          "name": "Health Check All Services",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["health"]
            }
          }
        },
        {
          "name": "Gateway Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000"
            }
          }
        }
      ]
    },
    {
      "name": "Points Service",
      "item": [
        {
          "name": "Get All Points",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3001/api/points",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "points"]
            }
          }
        },
        {
          "name": "Get Available Points",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3001/api/points?status=available",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "points"],
              "query": [{"key": "status", "value": "available"}]
            }
          }
        },
        {
          "name": "Get Points by Provider",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3001/api/points?provider=redPlug",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "points"],
              "query": [{"key": "provider", "value": "redPlug"}]
            }
          }
        },
        {
          "name": "Get Specific Point from RedPlug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3001/api/points/redPlug/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "points", "redPlug", "1"]
            }
          }
        },
        {
          "name": "Get Specific Point from GreenPlug",
          "request": {
            "method": "GET",
