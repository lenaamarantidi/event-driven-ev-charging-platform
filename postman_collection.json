        {
          "name": "Search Points with Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3001/api/search?status=available&provider=redPlug&capacity_min=20",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["api", "search"],
              "query": [
                {"key": "status", "value": "available"},
                {"key": "provider", "value": "redPlug"},
                {"key": "capacity_min", "value": "20"}
              ]
            }
          }
        },
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "url": {
